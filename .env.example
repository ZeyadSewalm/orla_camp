# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Paymob (Egypt: card + Fawry) ----
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=          # card integration id
PAYMOB_INTEGRATION_ID_FAWRY=    # optional, Fawry/kiosk integration id
PAYMOB_IFRAME_ID=
PAYMOB_HMAC_SECRET=

# ---- Tap Payments (Gulf / GCC / international) ----
# Dashboard -> Developers -> API Credentials. Use sk_test_* until you go live.
TAP_SECRET_KEY=
TAP_PUBLIC_KEY=

# ---- App ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Bunny Stream (video hosting) ----
BUNNY_LIBRARY_ID=
BUNNY_CDN_HOSTNAME=          # looks like vz-xxxxxxxx.b-cdn.net
BUNNY_API_KEY=               # Stream library API key — server only, never commit
BUNNY_TOKEN_KEY=             # library → Security → Token Authentication key

# ---- Google Drive STL tasks via Google Apps Script ----
# No Google Cloud Console / Client ID / Client Secret is needed.
# Create the bridge at script.google.com using google-apps-script/Code.gs.
GOOGLE_APPS_SCRIPT_URL=
GOOGLE_APPS_SCRIPT_SECRET=
# Hard safety ceiling. An assignment may set a smaller per-task limit.
TASK_UPLOAD_MAX_MB=512

# ---------------------------------------------------------------
# WhatsApp grade notifications (optional)
# ---------------------------------------------------------------
# Production URL of the n8n "Grade Notification - WhatsApp" workflow's Webhook
# node. Must contain /webhook/ — NOT /webhook-test/, which only fires while
# someone has the editor open. Unset = grading works, nothing is sent.
N8N_WHATSAPP_WEBHOOK_URL=

# Sent as the `x-orladent-secret` header. Configure the same value in the
# Webhook node under Authentication -> Header Auth. Without it the webhook is
# public, and anyone who finds the URL can send WhatsApp messages from
# OrlaDent's verified business number.
#   Generate:  openssl rand -hex 32
N8N_WEBHOOK_SECRET=

# Note: the inactivity reminder is NOT configured here. It runs entirely inside
# n8n on its own schedule and reads profiles.last_login_at, which the
# middleware keeps current (migration 019).
